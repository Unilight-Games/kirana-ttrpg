rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isDev() {
      return signedIn() && exists(/databases/$(db)/documents/config/site)
        && request.auth.uid in get(/databases/$(db)/documents/config/site).data.devUids;
    }
    // ---- ห้องที่ล็อกด้วยรหัส (v1.2) ----
    // roomsecrets/<rid> = {value} อ่านไม่ได้จากฝั่งเว็บ ใช้เทียบตอนสมัครเป็นสมาชิกเท่านั้น
    function roomLocked(rid) { return exists(/databases/$(db)/documents/roomsecrets/$(rid)); }
    function roomKey(rid) { return get(/databases/$(db)/documents/roomsecrets/$(rid)).data.value; }
    function isMember(rid) { return exists(/databases/$(db)/documents/rooms/$(rid)/members/$(request.auth.uid)); }
    function isRoomGm(rid) { return exists(/databases/$(db)/documents/rooms/$(rid)) && get(/databases/$(db)/documents/rooms/$(rid)).data.gmId == request.auth.uid; }
    function canEnter(rid) { return signedIn() && (isDev() || !roomLocked(rid) || isMember(rid) || isRoomGm(rid)); }

    // ตั้งค่าเว็บ: อ่านได้ทุกคน เขียนได้เฉพาะผู้พัฒนาที่ล็อกอิน Google (อ้างสิทธิ์ครั้งแรกได้เมื่อยังไม่มีผู้พัฒนา)
    match /config/{doc} {
      allow read: if true;
      allow write: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (resource == null || !('devUids' in resource.data) || resource.data.devUids.size() == 0 || request.auth.uid in resource.data.devUids);
    }
    // ชีทตัวละคร: เจ้าของเท่านั้น (ผู้พัฒนาเห็นทั้งหมด) — คนอื่นเห็นผ่านสำเนาในห้องที่ตัวละครถูกหยิบมาเล่น
    match /chars/{id} {
      allow read: if signedIn() && (isDev() || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && (isDev() || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if signedIn() && (isDev() || resource.data.ownerId == request.auth.uid);
    }
    // ผู้เล่นที่ออนไลน์: อ่านได้ทุกคนที่ล็อกอิน เขียนได้เฉพาะของตัวเอง
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // ล็อบบี้: รายชื่อห้องที่ทุกคนเห็น (ชื่อ GM มีรหัสไหม จำนวนหมาก) เขียนโดยคนที่เข้าห้องนั้นได้
    match /lobby/{rid} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if canEnter(rid);
    }
    // รหัสเข้าห้อง: ไม่มีใครอ่านได้ GM ผู้สร้างห้อง (หรือผู้พัฒนา) ตั้ง/ลบ
    match /roomsecrets/{rid} {
      allow read: if false;
      allow write: if signedIn() && (isDev() || isRoomGm(rid));
    }
    // ห้องเล่น: ห้องไม่มีรหัส = ทุกคนที่ล็อกอิน · ห้องมีรหัส = สมาชิก GM ผู้พัฒนา
    match /rooms/{rid} {
      allow create: if signedIn();
      allow read, update, delete: if canEnter(rid);
      // สมัครเป็นสมาชิกด้วยรหัสที่ถูกต้อง (หรือห้องไม่มีรหัส) ลบตัวเองได้ GM ลบใครก็ได้
      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isRoomGm(rid) || isDev());
        allow create: if signedIn() && request.auth.uid == uid
          && (!roomLocked(rid) || request.resource.data.key == roomKey(rid));
        allow update: if signedIn() && request.auth.uid == uid && isMember(rid);
        allow delete: if signedIn() && (request.auth.uid == uid || isRoomGm(rid) || isDev());
      }
      // แชต สำเนาชีทในห้อง ล็อกทอย presence ในห้อง: เฉพาะคนที่เข้าห้องได้
      match /chat/{doc} { allow read, write: if canEnter(rid); }
      match /chars/{doc} { allow read, write: if canEnter(rid); }
      match /meta/{doc} { allow read, write: if canEnter(rid); }
      match /presence/{doc} { allow read, write: if canEnter(rid); }
      // ไอเทมที่ GM มอบให้ (เจ้าของรับเข้ากระเป๋าแล้วลบ)
      match /gifts/{doc} { allow read, write: if canEnter(rid); }
    }
    // คลังแผนที่ (v1.5): ส่วนตัวของเจ้าของ จนกว่าจะ published = true แล้วทุกคนที่ล็อกอินอ่านได้ (เก็บสำเนาเป็นเอกสารใหม่ของตัวเอง)
    match /maps/{id} {
      allow read: if signedIn() && (isDev() || resource.data.published == true || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && (isDev() || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if signedIn() && (isDev() || resource.data.ownerId == request.auth.uid);
    }
    // ภาพประกอบแผนที่ (v1.6): ของเจ้าของเท่านั้น ไม่ติดไปกับการเผยแพร่
    match /mapimages/{id} {
      allow read, update, delete: if signedIn() && (isDev() || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
